const int lat_sen_dis = 103; // distance between 2 lat sensors (mm)
float desired_wall_dist = 150; // mm, TODO: set the distance you want to hold from the wall

// motors (A = right wheel, B = left wheel)
const int A_pinF = 6;
const int A_pinR = 5;
const int B_pinF = 9;
const int B_pinR = 10;

// Controller (class form): two PI terms summed, one on heading error and one on lateral error
//   steer = Kp_H*e_H + Ki_H*integral(e_H) + Kp_L*e_L + Ki_L*integral(e_L)
// Wall is on the RIGHT. e_L > 0 = too far from wall, e_H > 0 = front further from wall than back.
// Both positive -> steer right. Signs are flipped vs the class equation's minus signs by STEER_SIGN.
float Kp_H = 0.5;          // PWM per degree of heading error
float Ki_H = 0.0;         // PWM per (degree * s)   start at 0
float Kp_L = 0.5;         // PWM per mm of lateral error
float Ki_L = 0.03;        // PWM per (mm * s)
const float I_MAX_H = 200; // degree*s, integral clamp (anti-windup)
const float I_MAX_L = 500; // mm*s, integral clamp (anti-windup)
const float MAX_STEER = 40;      // PWM, max difference applied to each wheel
int left_trim = 8;         // PWM subtracted from the LEFT wheel to drive straight. Negative = speed the left wheel up. Tune with m<n>.
float max_approach_deg = 20;  // lateral error can never ask for more than this approach angle toward/away from the wall
int base_speed = 110;      // PWM, forward speed (keep base +/- MAX_STEER above your minimum PWM)
const int STEER_SIGN = 1;  // flip to -1 if the robot steers away from the wall instead of toward it

float integral_H = 0;
float integral_L = 0;
bool guard_active = false;   // true when a side sensor had no echo and PID was skipped (for debugging)
unsigned long last_pid_ms = 0;

// Corner turning (no encoders/gyro, so turns are timed)
float front_stop_dist = 0.13;   // m, wall straight ahead this close -> turn
int turn_speed = 130;           // PWM for turning on the spot (above your minimum PWM)
long turn_90_ms = 675;         // ms for ~90 deg at turn_speed. TUNE THIS on the floor.

// State machine
enum State {
  FOLLOW_WALL,     // drive forward holding desired_wall_dist from the right wall
  TURN_LEFT_90     // spin left on the spot for turn_90_ms
  // TURN_RIGHT_90 goes here later
};
State state = FOLLOW_WALL;

const int SENSOR_GAP_MS = 30;  // ms between pinging different sensors
unsigned long state_start = 0;

// median-of-3 filter on each ultrasonic sensor (rejects single bad readings and timeouts)
float hist_back[3] = {4.0, 4.0, 4.0};
float hist_front[3] = {4.0, 4.0, 4.0};
float hist_ahead[3] = {4.0, 4.0, 4.0};
int hist_idx = 0;

const int latBackTrigPin = 7;
const int latBackEchoPin = 8;

const int latFrontTrigPin = 3;
const int latFrontEchoPin = 4;

const int aheadTrigPin = 12;    // forward-facing sensor
const int aheadEchoPin = 13;

void setup() {
  Serial.begin(9600);
  Serial.setTimeout(50);
  Serial.println("Tune: h<Kp_H> j<Ki_H> p<Kp_L> i<Ki_L> s<base speed> m<left trim> a<max approach deg> w<wall dist mm> t<turn ms> f<front stop cm>, e.g. p0.3  (send with newline)");

  pinMode(latBackTrigPin, OUTPUT);
  pinMode(latBackEchoPin, INPUT);
  pinMode(latFrontTrigPin, OUTPUT);
  pinMode(latFrontEchoPin, INPUT);
  pinMode(aheadTrigPin, OUTPUT);
  pinMode(aheadEchoPin, INPUT);

  pinMode(A_pinF, OUTPUT);
  pinMode(A_pinR, OUTPUT);
  pinMode(B_pinF, OUTPUT);
  pinMode(B_pinR, OUTPUT);

  stopMove();
  delay(5000); // wait 5 s before starting for safety

  // run the sensors for ~1 s with the wheels stopped so the filters settle before moving
  unsigned long warm_start = millis();
  while (millis() - warm_start < 1000) {
    primeFilters();
  }
  last_pid_ms = millis();
  setState(FOLLOW_WALL);
}

void loop() {
  handleSerialTuning();

  // ---------- SENSORS (one at a time, spaced so pings don't interfere) ----------
  float raw_back = readLateralBackSensorData();
  delay(SENSOR_GAP_MS);
  float raw_front = readLateralFrontSensorData();
  delay(SENSOR_GAP_MS);
  float raw_ahead = readAheadSensorData();

  hist_back[hist_idx] = raw_back;
  hist_front[hist_idx] = raw_front;
  hist_ahead[hist_idx] = raw_ahead;
  hist_idx = (hist_idx + 1) % 3;
  float back = median3(hist_back[0], hist_back[1], hist_back[2]);
  float front = median3(hist_front[0], hist_front[1], hist_front[2]);
  float ahead = median3(hist_ahead[0], hist_ahead[1], hist_ahead[2]);

  float angle = angle_from_wall(back, front);
  float wall_dist = perp_dist_to_wall(back, front, angle);
  float lat_error = wall_dist - desired_wall_dist;

  // ---------- STATE MACHINE ----------
  float steer_cmd = 0;
  switch (state) {
    case FOLLOW_WALL:
      steer_cmd = followWall(back, front, angle, lat_error, ahead);
      break;
    case TURN_LEFT_90:
      turnLeft90();
      break;
  }

  Serial.print(" State:");
  Serial.print(stateName(state));
  Serial.print(" Ahead:");
  Serial.print(ahead);
  Serial.print(" Front:");
  Serial.print(front);
  Serial.print(" Back:");
  Serial.print(back);
  Serial.print(" Angle:");
  Serial.print(angle);
  Serial.print(" WallDist_mm:");
  Serial.print(wall_dist);
  Serial.print(" LatErr_mm:");
  Serial.print(lat_error);
  Serial.print(" Steer:");
  Serial.print(steer_cmd);
  Serial.print(" NoEcho:");
  Serial.println(guard_active ? 1 : 0);
}


// ---------- STATES ----------

// FOLLOW_WALL: PI wall following; if a wall is straight ahead, switch to TURN_LEFT_90.
// Returns the steering command (for printing).
float followWall(float back, float front, float angle, float lat_error, float ahead) {
  if (ahead <= front_stop_dist) {
    stopMove();
    Serial.println("Wall ahead. Turning left 90.");
    setState(TURN_LEFT_90);
    return 0;
  }

  unsigned long now = millis();
  float dt = (now - last_pid_ms) / 1000.0;
  last_pid_ms = now;

  float steer_cmd = 0;
  if (back >= 4.0 || front >= 4.0) {
    // no echo from one side sensor: drive straight, don't let the integrals wind up
    guard_active = true;
    integral_H = 0;
    integral_L = 0;
  } else {
    guard_active = false;
    steer_cmd = pid_steer(lat_error, angle, dt);
  }

  // steer_cmd > 0 -> turn right: left wheel faster, right wheel slower
  steer(base_speed - steer_cmd, base_speed + steer_cmd);
  return steer_cmd;
}

// TURN_LEFT_90: spin on the spot for turn_90_ms, then go back to wall following
void turnLeft90() {
  turnLeft(turn_speed);

  if (millis() - state_start >= (unsigned long)turn_90_ms) {
    stopMove();
    finishTurn();
  }
}

// reset everything the controller remembers, then resume wall following
void finishTurn() {
  integral_H = 0;
  integral_L = 0;
  primeFilters();            // old readings were from before the turn
  last_pid_ms = millis();
  setState(FOLLOW_WALL);
}

void setState(State s) {
  state = s;
  state_start = millis();
  Serial.print("-> ");
  Serial.println(stateName(s));
}

const char* stateName(State s) {
  switch (s) {
    case FOLLOW_WALL:  return "FOLLOW_WALL";
    case TURN_LEFT_90: return "TURN_LEFT_90";
  }
  return "?";
}


// ---------- SENSOR HELPERS ----------

// fill the median filters with fresh readings
void primeFilters() {
  for (int i = 0; i < 3; i++) {
    hist_back[i] = readLateralBackSensorData();
    delay(30);
    hist_front[i] = readLateralFrontSensorData();
    delay(30);
    hist_ahead[i] = readAheadSensorData();
    delay(30);
  }
}

float median3(float a, float b, float c) {
  if ((a >= b && a <= c) || (a <= b && a >= c)) return a;
  if ((b >= a && b <= c) || (b <= a && b >= c)) return b;
  return c;
}

float angle_from_wall(float back, float front) {
    float latBackDistance = back * 1000;   // m -> mm
    float latFrontDistance = front * 1000; // m -> mm

    float a = abs(latBackDistance - latFrontDistance);
    float b = lat_sen_dis;

    float abs_angle = degrees(atan2(a, b));

    if (latBackDistance < latFrontDistance) {
        return abs_angle;
    }
    else if (latBackDistance > latFrontDistance) {
        return -abs_angle;
    }
    else {
        return 0;
    }
}

// True perpendicular distance to the wall (mm): average reading * cos(heading error)
float perp_dist_to_wall(float back, float front, float angle_deg) {
  float mid_mm = (back + front) / 2.0 * 1000;   // m -> mm
  return mid_mm * cos(radians(angle_deg));
}

float readLateralBackSensorData() {
  return readSensor(latBackTrigPin, latBackEchoPin);
}

float readLateralFrontSensorData() {
  return readSensor(latFrontTrigPin, latFrontEchoPin);
}

float readAheadSensorData() {
  return readSensor(aheadTrigPin, aheadEchoPin);
}

// distance in metres, 4.0 = no echo
float readSensor(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  float time = pulseIn(echoPin, HIGH, 30000) * 1e-6;
  if (time == 0) return 4.0;     // no echo = nothing there
  return time * 343 * 0.5;       // meters
}


// ---------- TUNING ----------

// Live tuning over Serial: a letter then a number, e.g. "p0.3" or "w180"
void handleSerialTuning() {
  if (!Serial.available()) return;

  char cmd = Serial.read();
  if (cmd == '\n' || cmd == '\r' || cmd == ' ') return;
  float v = Serial.parseFloat();
  while (Serial.available()) Serial.read();   // drop the rest of the line

  switch (cmd) {
    case 'h': Kp_H = v; break;
    case 'j': Ki_H = v; break;
    case 'p': Kp_L = v; break;
    case 'i': Ki_L = v; break;
    case 's': base_speed = (int)v; break;
    case 'm': left_trim = (int)v; break;
    case 'a': max_approach_deg = v; break;
    case 'w': desired_wall_dist = v; break;
    case 't': turn_90_ms = (long)v; break;
    case 'f': front_stop_dist = v / 100.0; break;   // cm -> m
    default:
      Serial.println("Unknown command. Use h j p i s m w t f a.");
      return;
  }
  integral_H = 0;   // restart the integrals after any change
  integral_L = 0;

  Serial.print("Kp_H=");  Serial.print(Kp_H);
  Serial.print(" Ki_H="); Serial.print(Ki_H);
  Serial.print(" Kp_L="); Serial.print(Kp_L);
  Serial.print(" Ki_L="); Serial.print(Ki_L);
  Serial.print(" base="); Serial.print(base_speed);
  Serial.print(" trim="); Serial.print(left_trim);
  Serial.print(" maxApproach="); Serial.print(max_approach_deg);
  Serial.print(" wall="); Serial.print(desired_wall_dist);
  Serial.print(" turn_ms="); Serial.print(turn_90_ms);
  Serial.print(" front_stop_cm="); Serial.println(front_stop_dist * 100);
}

// Class-form controller. Returns steering PWM, + = turn right.
float pid_steer(float lat_err, float heading_deg, float dt) {
  integral_H += heading_deg * dt;
  integral_H = constrain(integral_H, -I_MAX_H, I_MAX_H);
  integral_L += lat_err * dt;
  integral_L = constrain(integral_L, -I_MAX_L, I_MAX_L);

  // Lateral part is limited to what Kp_H would produce at max_approach_deg, so a big distance error
  // can only ask for a modest approach angle instead of turning the robot toward/away from the wall.
  float u_lat = Kp_L * lat_err + Ki_L * integral_L;
  float lat_limit = Kp_H * max_approach_deg;
  u_lat = constrain(u_lat, -lat_limit, lat_limit);

  float u = Kp_H * heading_deg + Ki_H * integral_H + u_lat;
  u = constrain(u, -MAX_STEER, MAX_STEER);
  return STEER_SIGN * u;
}


// ---------- MOTORS ----------

// Drive both wheels forward at separate speeds: right wheel (A), left wheel (B)
void steer(float speedRight, float speedLeft) {
  analogWrite(A_pinF, constrain((int)speedRight, 0, 255));
  analogWrite(A_pinR, 0);
  analogWrite(B_pinF, constrain((int)speedLeft - left_trim, 0, 255));   // left_trim evens out the two motors
  analogWrite(B_pinR, 0);
}

// Spin left on the spot: right wheel forward, left wheel backward
void turnLeft(int s) {
  analogWrite(A_pinF, s);
  analogWrite(A_pinR, 0);
  analogWrite(B_pinF, 0);
  analogWrite(B_pinR, s);
}

void stopMove() {
  analogWrite(A_pinF, 0);
  analogWrite(A_pinR, 0);
  analogWrite(B_pinF, 0);
  analogWrite(B_pinR, 0);
}
